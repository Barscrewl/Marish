    // Mono-space font required
	{
		// Native base-layout mechanism is permitted for this profile; TECH must
		// also opt its own AI instance in. Other roles retain normal placement.
		"layout": {
			"enabled": true
		},
		//attack = 0.3 means enemy threat = enemy_threat*0.3																																																																																																																																																																																																																																																			[Reworked by [SMRT]Felnious[AI]]
		//and attack group select only targets that have threat lower than the group's power. Power is like threat, but behaviour.json has separate modifiers for threat (enemy) and power (own).
		//with attack=0.8..1.0 AI acts more careful, if it would also fight superior enemy near own static defences then those values would be great. 
		//But there's possibility that AI will just run from enemy till it has big enough group, but it may loose its base. So if with attack=0.8..1.0 AI is not loosing base then everything is ok and i think this range is optimal.
	
		"quota": {
			"scout": 2,  // max scout units out of raiders
			"raid": [8.0, 180.0],  // [<min>, <avg>] power of raider squad
			"attack": 60.0,  // min power of attack group
			"thr_mod": {				//AI attacks everything with final threat (after all calculations) <= 1
				"attack": [0.8, 1.5],//"attack": [0.6, 0.8],  // [<min>, <max>] enemy threat multiplier for target selection of attack task |  values <1 makes enemy group seem less of an thread for ai => ai attacks stronger groups than it own | org=0.25, 0.3
				"defence": [0.8, 1.0],//"defence": [0.3, 0.5],  // [<min>, <max>] enemy threat modifier for group size calculation of defence task; org=0.95, 0.95 | high values = low risk; low values = high risk 
				"mobile": 1.05,  // initial modifier for power of attack group based on mobile enemy threat; org=1.05
				"static": 0.8,  // initial modifier for power of attack group based on static enemy threat; org= 1.2
				"comm": 0.05   // because of power of dgun
			},
			// anti-air threat threshold, air factories will stop production when AA threat exceeds
			"aa_threat": [[8, 99999.0], [96, 500000.0]],  // [[<map_start>, <threat_start>], [<map_end>, <threat_end>]]
			"slack_mod": {
				"all": 0.05,  // threat map 64-elmos slack multiplier for all units
				"static": 0.05,  // additional 64-elmo-cells for static units
				"speed": [0.75, 4.0]  // [<64elmo_cells_speed_mod>, <max_64elmo_cells>]
			},
			"num_batch": 5, //repeat unit build if response factory build is called
			"anti_cap": 2.0  // probability 0.0~1.0 of AntiCapture action
		},
	
		// If unit's health drops below specified percent it will retreat
		"retreat": {
			"builder": [0.8, 0.89, 1.0],  // [<min default>, <max default>, <UnitDef modifier>] for all builders
			"fighter": [0, 0.20, 1.0],  // [<min default>, <max default>, <UnitDef modifier>] for all not-builder units
			"shield": [0.25, 0.55]  // [<empty>, <full>] shield power
		},
	
	
		// following block is all about defense
		"defence": {
			"infl_rad": 16,  // influenece cell radius for defendAlly map
			"base_rad": [900.0, 1800.0],  // BASE DEFENDING RADIUS: defend if enemy within clamp(distance(lane_pos, base_pos), 1000, 2000)
			"comm_rad": [1000.0, 800.0],  // 0 distance from base ~ 1000, base_rad ~ 500.0 => comm_rad is radius within which it checks for enemy. It's largest near base and smaller at the edge of base_rad
			"escort": [3, 1, 540]  // [<builders_count>, <defenders_count>, <escort rule until this time>]  2,2,360
		},

		// Pulse weapons (Juno). The pulse does 1 damage; unit_juno_damage.lua
		// deletes the defs it flags inside the blast, so target choice has to be
		// by what it can actually delete, never by enemy metal cost. "role" marks
		// the def that carries a pulse weapon; "jammer" and "radar" mark its
		// worthwhile targets (append those roles to the sensor defs below);
		// "priority" orders the four target classes and omitting a class means
		// never target it. See doc/juno-targets.md.
		"pulse": {
			"enabled": true,
			"role": "juno",
			"jammer": "jammer",
			"radar": "radar",
			"priority": ["jammer_static", "radar_static", "jammer_mobile", "radar_mobile"],
			"mobile_max_age": 60,  // seconds a mobile target's last known position stays usable
			"min_targets": 1,      // raise to require a cluster before spending 200 M + 12000 E
			"suspect_jammer": true,      // fall back to inferring a jammer from a radar hole
			"hole_probe_radius": 760,    // widest BAR jam radius; probe this far off a known contact
			"hole_radius": 500,          // a probe with no contact inside this is a hole
			"hole_min_enemy_infl": 0.05, // only where we believe the enemy operates
			"hole_probes": 8
		},

		// EMP weapons (Paralyzer). A paralyzer deals no health damage, so a shot
		// is worth firing only when it lands a stun, and that is arithmetic:
		//   effective = paralyzeDamage * paralyzemultiplier * salvo
		//   stunned iff effective > maxHealth
		//   seconds = decline_rate * (min(effective/maxHealth, cap) - 1)
		// Targets that cannot be held are rejected outright, so the AI never
		// spends 500 M + 15644 E on a commander, a Juggernaut or an aircraft.
		// "role" marks the def carrying the weapon and "anti_nuke" the one class
		// ranked above raw value; every other EMPABLE, stunnable target is ranked
		// structures-first and then by metal, which floats Ragnarok, AFUS, gantry
		// and nuclear silo to the top without tagging any of them.
		// See doc/emp-targets.md.
		"emp": {
			"enabled": true,
			"role": "emp",
			"anti_nuke": "anti_nuke",
			"category": "EMPABLE",       // BAR: SURFACE and paralyzemultiplier != 0
			"decline_rate": 40,          // modrules.paralyze.paralyzeDeclineRate; 20 with emprework
			"min_stun": 5.0,             // seconds; below this the shot is not worth its cost
			"mobile_max_age": 30,        // seconds a mobile target's last known position stays usable
			"min_targets": 1,
			"structures_first": true,
			"structures_first_min_cost": 1500  // only statics this expensive outrank mobiles; below it, highest cost wins     // only structures get an uncapped stun
		},

		// Bombers. A pass is alpha damage: it kills or it is wasted, so a group
		// ranks by value per HP, refuses what it cannot finish while anything
		// finishable is in range, and chooses between concentrating on one
		// target and spreading a line across a front. See doc/bomber-targeting.md.
		"bomber": {
			"enabled": true,
			"kill_margin": 1.15,      // a target needing more than groupAlpha * this is left for a bigger group
			"focus_cost": 1500,       // a target worth this much alone always keeps the group concentrated
			"area_min_targets": 3,    // candidates inside area_radius before the group spreads into a line
			"area_radius": 900,
			"min_spacing": 96,        // line spacing floor; the ceiling is 2 x weapon AoE
			"cleanup_distance": 900,  // attack-move this far past the front so survivors leave, not loiter
			"approach_samples": 8,    // threat-map probes on the ring to pick the run-in bearing
			"approach_ring": 1200,
			"group_mixed_defs": true  // one line for a mixed wave instead of parallel per-def groups
		},
		"stockpile": {
			// Stockpiled super weapons (nukes, the tactical launchers, and any stockpiled weapon on the
			// generic group scan - not the EMP and Juno policies, which target from their own branches
			// before this floor is reached) only fire at a group worth their shot
			// cost - metal that is already spent. A silo held three missiles against a
			// discovered base because the visible group value never reached 1500. The floor
			// now decays with waiting time and collapses once enough shots are stocked.
			"patience_seconds": 240,   // floor decays from full to min_fraction over this
			"min_fraction": 0.25,      // never below this fraction of the shot cost
			"full_fire_count": 2,      // this many stocked: floor is min_fraction immediately
			// Tactical launchers (Perdition 2300, Catalyst 2250) aim by scanning units in range
			// and valuing the metal inside the blast; enemy-group centroids never came within
			// reach of a launcher sat in a cluster (every logged tick: inRange=0).
			"launcher_mobile_max_age": 30,     // seconds a mobile's last known position stays usable
			"launcher_min_targets": 1,         // raise to require a clump inside the blast
			"launcher_structures_first": false // true ranks any structure above any mobile
		},
		"sensor": {
			// Mobile radar and jammer escorts. They carry the `support` main role,
			// which walks each of them into the nearest squad with no cap - one
			// game on Eight Horses put 27 radar bots behind a single sharpshooter.
			// A squad can only use one, so the escort is rationed and the scarce
			// sensors go to the highest-tier squads first.
			// See doc/sensor-escort.md.
			"enabled": true,
			"jammer": "jammer",     // the config roles that mark a rationed escort;
			"radar": "radar",       // the same tags the "pulse" block hunts on the enemy side
			"max_per_squad": 1,     // "unless it dies": only live escorts are counted
			"top_candidates": 3,    // aim at the nearest of the N most valuable uncovered squads
			"rebalance": true       // release the surplus when two escorted squads merge
		},
		// read of "escort":  [number of builders with defenders, number of defenders for each builder, timeframe were only escorted builders are able to expand (=build mex, porc)]
		// base radius: ai checks if is withing base_rad. if there is enemy it checks if it is withing comm radius which is variable and depend on distance from base
		// if there is, then ai checks speed, direction and threat on enemys position. if all conditions positive => com attacks
	
		//------- THREAT MODIFIERS ---------
		// "threat"  : how ai sees enemy units
		// "power" : how ai sees own units
		// threat categories: air, surface (= water & land), water (= underwater), default
		// threat roles: scout, raider, skrimish, assault, heavy, anti_heavy, artillery, super
	
		//when are thread modifiers needed?
		// => basically when the simple formula dps*hp does not work to calculate the thread/power of a unit:
		// - overshooting
		// -inability to hit a certain target due to slow/bad aiming or inability to attack at all (cause target is air or underwater etc. )
		// -aoe
		// -dps of paralyzer weapons or dgun
		
		//MODIFIER MAINLY USED BY STRUCTURES
		// "build_mod": 1000.0,
			// build_mod allows to de/increase the max amount of builder individually for each building type. values > 1000 => less builders; values <1000 more builders
			// assign builders till targeted time to build reached
			// default value specified in economy-> build_mod
			// goal_build_time (economy.json)= build_mod / metal_income
		// "coolddown":1, ----- Amount of seconds when unit is not available for construction after UnitFinished
			
	
